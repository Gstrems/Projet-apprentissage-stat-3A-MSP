# Stacking de XGboost et RF

## Préparation des données

```{r}

df <- read.csv2(
  "Imputé final.csv",
  sep = ";",
  stringsAsFactors = FALSE
)

df[, c(2:16,18)] <- lapply(
  df[, c(2:16,18)],
  factor
)

# Mise en forme des données
data_rf <- df[, c(18, 2:17)]
names(data_rf)[1] <- "Y"

data_rf$Y <- factor(
  data_rf$Y
)

# Poids
data_rf$pm17B <- as.numeric(
  as.character(data_rf$pm17B)
)

```

## Séparation apprentissage / test

On utilise un seul découpage apprentissage/test pour les trois modèles afin que leurs performances soient comparables.

```{r}

set.seed(42)

train_index <- createDataPartition(
  data_rf$Y,
  p = 0.70,
  list = FALSE
)

train_data <- data_rf[
  train_index,
  ,
  drop = FALSE
]

test_data <- data_rf[
  -train_index,
  ,
  drop = FALSE
]

classes <- levels(train_data$Y)
K <- length(classes)

# 5 folds communs à RF et XGBoost
set.seed(42)

folds <- createFolds(
  train_data$Y,
  k = 5,
  list = TRUE,
  returnTrain = FALSE
)

```

# Paramètres de RF

```{r}

################################################################################
# TUNING RANDOM FOREST PAR VALIDATION CROISEE
################################################################################

# Variables explicatives
rf_features <- setdiff(
  names(train_data),
  c("Y", "pm17B")
)

# Hyperparamètres testés
rf_grid <- expand.grid(
  mtry = 1:7,
  num.trees = seq(50, 500, by = 50),
  min.node.size = c(1, 5, 10)
)

# Par VC, on teste le nb d'arbres, mtry et la taille de noeud minimale des arbres de la RF
# Attention c'est un peu lourd à compiler

rf_results <- rf_grid %>%
  mutate(
    cv_error = pmap_dbl(
      list(
        mtry,
        num.trees,
        min.node.size
      ),
      function(m, ntree, node) {

        fold_errors <- map_dbl(
          folds,
          function(valid_index) {

            train_fold <- train_data[
              -valid_index,
              ,
              drop = FALSE
            ]

            valid_fold <- train_data[
              valid_index,
              ,
              drop = FALSE
            ]

            model <- ranger(
              Y ~ . - pm17B,
              data = train_fold,
              mtry = m,
              num.trees = ntree,
              min.node.size = node,
              importance = "permutation",
              classification = TRUE,
              probability = FALSE,
              case.weights = train_fold$pm17B
            )

            pred <- predict(
              model,
              data = valid_fold[
                ,
                rf_features,
                drop = FALSE
              ]
            )$predictions

            mean(
              pred != valid_fold$Y
            )
          }
        )

        mean(fold_errors)
      }
    )
  )

# Meilleur modèle
best_rf <- rf_results %>%
  slice_min(
    cv_error,
    n = 1,
    with_ties = FALSE
  )

rf_mtry <- best_rf$mtry
rf_ntree <- best_rf$num.trees
rf_node <- best_rf$min.node.size

cat(
  "Meilleur modèle : mtry =",
  rf_mtry,
  ", ntree =",
  rf_ntree,
  ", min.node.size =",
  rf_node,
  ", erreur CV =",
  round(best_rf$cv_error, 4),
  "\n"
)

```

```{r}

# Visualisation de l'erreur CV
ggplot(
  rf_results %>%
    filter(
      min.node.size == rf_node
    ),
  aes(
    x = num.trees,
    y = cv_error,
    color = as.factor(mtry)
  )
) +
  geom_line(linewidth = 1.2) +
  geom_point(size = 2) +
  labs(
    title = "Erreur de validation croisée selon le nombre d'arbres et mtry",
    x = "Nombre d'arbres (num.trees)",
    y = "Erreur CV",
    color = "mtry"
  ) +
  theme_minimal()

```

```{r}


rf_mtry #2 
rf_ntree #100
rf_node  #10
```

Voici donc les paramètres optimaux pour notre Random Forest.

## Paramètres de XGBoost

```{r}

################################################################################
# TUNING XGBOOST PAR VALIDATION CROISEE
################################################################################

# Transformation des variables qualitatives en variables numériques
x_train <- model.matrix(
  Y ~ . - pm17B - 1,
  data = train_data
)

x_test <- model.matrix(
  Y ~ . - pm17B - 1,
  data = test_data
)

# Même ordre de colonnes pour train et test
x_test <- x_test[
  ,
  colnames(x_train),
  drop = FALSE
]

# Classes numériques 0, ..., K-1
y_train <- as.numeric(
  train_data$Y
) - 1

y_test <- as.numeric(
  factor(
    test_data$Y,
    levels = classes
  )
) - 1

# Poids
w_train <- train_data$pm17B
w_test <- test_data$pm17B

################################################################################
# HYPERPARAMETRES TESTES
################################################################################

xgb_grid <- expand.grid(
  max_depth = c(2, 3, 4, 5, 6),
  nrounds = c(50, 100, 150, 200, 300),
  eta = c(0.01, 0.05, 0.10, 0.20)
)

################################################################################
# VALIDATION CROISEE
################################################################################

xgb_results <- xgb_grid %>%
  mutate(
    cv_error = pmap_dbl(
      list(
        max_depth,
        nrounds,
        eta
      ),
      function(depth, rounds, learning_rate) {

        fold_errors <- map_dbl(
          folds,
          function(valid_index) {

            train_index_fold <- setdiff(
              seq_len(nrow(train_data)),
              valid_index
            )

            dtrain <- xgb.DMatrix(
              x_train[
                train_index_fold,
                ,
                drop = FALSE
              ],
              label = y_train[
                train_index_fold
              ],
              weight = w_train[
                train_index_fold
              ]
            )

            dvalid <- xgb.DMatrix(
              x_train[
                valid_index,
                ,
                drop = FALSE
              ],
              label = y_train[
                valid_index
              ]
            )

            model <- xgb.train(
              params = list(
                objective = "multi:softprob",
                num_class = K,
                max_depth = depth,
                eta = learning_rate,
                eval_metric = "merror"
              ),
              data = dtrain,
              nrounds = rounds,
              verbose = 0
            )

            # Probabilités prédites
            pred_prob <- predict(
              model,
              dvalid
            )

            pred_prob <- matrix(
              pred_prob,
              ncol = K,
              byrow = TRUE
            )

            # Classe prédite
            pred_class <- max.col(
              pred_prob
            ) - 1

            # Erreur de classification
            mean(
              pred_class != y_train[
                valid_index
              ]
            )
          }
        )

        mean(fold_errors)
      }
    )
  )

################################################################################
# MEILLEURS PARAMETRES
################################################################################

best_xgb <- xgb_results %>%
  slice_min(
    cv_error,
    n = 1,
    with_ties = FALSE
  )

xgb_max_depth <- best_xgb$max_depth
xgb_nrounds <- best_xgb$nrounds
xgb_eta <- best_xgb$eta

cat(
  "Meilleur modèle XGBoost : max_depth =",
  xgb_max_depth,
  ", nrounds =",
  xgb_nrounds,
  ", eta =",
  xgb_eta,
  ", erreur CV =",
  round(best_xgb$cv_error, 4),
  "\n"
)

```

```{r}

# Affichage des 10 meilleures combinaisons
xgb_results %>%
  arrange(cv_error) %>%
  head(10)

```

```{r}

# Visualisation de l'erreur CV
ggplot(
  xgb_results,
  aes(
    x = nrounds,
    y = cv_error,
    color = factor(max_depth),
    group = max_depth
  )
) +
  geom_line(linewidth = 1.1) +
  geom_point(size = 2) +
  facet_wrap(~ eta) +
  labs(
    title = "Erreur de validation croisée - XGBoost",
    x = "Nombre d'itérations (nrounds)",
    y = "Erreur moyenne CV",
    color = "max_depth"
  ) +
  theme_minimal()

```

```{r}

xgb_max_depth
xgb_nrounds
xgb_eta

```

Avec les paramètres de RF et XGBoost, on peut passer au stacking.

# Stacking

## Préparation des folds

```{r}

n_folds <- length(folds)

# Noms internes du stacking
rf_names <- paste0(
  "RF_C",
  seq_len(K)
)

xgb_names <- paste0(
  "XGB_C",
  seq_len(K)
)

oof_rf <- matrix(
  NA_real_,
  nrow = nrow(train_data),
  ncol = K,
  dimnames = list(
    NULL,
    rf_names
  )
)

oof_xgb <- matrix(
  NA_real_,
  nrow = nrow(train_data),
  ncol = K,
  dimnames = list(
    NULL,
    xgb_names
  )
)

```

On passe aux folds.

```{r}

# Predictions out of fold pour rf et xg

for (i in seq_along(folds)) {

  valid <- folds[[i]]

  train <- setdiff(
    seq_len(nrow(train_data)),
    valid
  )

  train_fold <- train_data[
    train,
    ,
    drop = FALSE
  ]

  valid_fold <- train_data[
    valid,
    ,
    drop = FALSE
  ]

  # ---------------- RF ----------------

  rf <- ranger(
    Y ~ . - pm17B,
    data = train_fold,
    num.trees = rf_ntree,
    mtry = rf_mtry,
    min.node.size = rf_node,
    probability = TRUE,
    case.weights = train_fold$pm17B,
    seed = 123 + i
  )

  oof_rf[
    valid,
  ] <- predict(
    rf,
    valid_fold[
      ,
      rf_features,
      drop = FALSE
    ]
  )$predictions[
    ,
    classes,
    drop = FALSE
  ]


  # ---------------- XGBoost ----------------

  dtrain <- xgb.DMatrix(
    x_train[
      train,
      ,
      drop = FALSE
    ],
    label = y_train[
      train
    ],
    weight = w_train[
      train
    ]
  )

  dvalid <- xgb.DMatrix(
    x_train[
      valid,
      ,
      drop = FALSE
    ],
    label = y_train[
      valid
    ]
  )

  xgb <- xgb.train(
    params = list(
      objective = "multi:softprob",
      num_class = K,
      max_depth = xgb_max_depth,
      eta = xgb_eta,
      eval_metric = "mlogloss"
    ),
    data = dtrain,
    nrounds = xgb_nrounds,
    verbose = 0
  )

  oof_xgb[
    valid,
  ] <- matrix(
    predict(
      xgb,
      dvalid
    ),
    ncol = K,
    byrow = TRUE
  )
}

```

## Méta-modèle multinomial

```{r}

meta_data <- data.frame(
  oof_rf,
  oof_xgb,
  Y = train_data$Y,
  check.names = FALSE
)

meta_model <- multinom(
  Y ~ .,
  data = meta_data,
  trace = FALSE
)

```

## RF et XGBoost finaux

```{r}

###################################################
# RF et XGBOOST finaux

# ---------------- RF ----------------

final_rf <- ranger(
  Y ~ . - pm17B,
  data = train_data,
  num.trees = rf_ntree,
  mtry = rf_mtry,
  min.node.size = rf_node,
  probability = TRUE,
  case.weights = w_train,
  importance = "permutation",
  seed = 999
)

pred_rf_test <- predict(
  final_rf,
  test_data[
    ,
    rf_features,
    drop = FALSE
  ]
)$predictions[
  ,
  classes,
  drop = FALSE
]


# ---------------- XGBoost ----------------

dtrain <- xgb.DMatrix(
  x_train,
  label = y_train,
  weight = w_train
)

dtest <- xgb.DMatrix(
  x_test,
  label = y_test,
  weight = w_test
)

final_xgb <- xgb.train(
  params = list(
    objective = "multi:softprob",
    num_class = K,
    max_depth = xgb_max_depth,
    eta = xgb_eta,
    eval_metric = "mlogloss"
  ),
  data = dtrain,
  nrounds = xgb_nrounds,
  verbose = 0
)

pred_xgb_test <- matrix(
  predict(
    final_xgb,
    dtest
  ),
  ncol = K,
  byrow = TRUE
)

colnames(pred_xgb_test) <- classes

```

## Prédictions du stacking

```{r}

colnames(pred_rf_test) <- rf_names
colnames(pred_xgb_test) <- xgb_names

meta_test <- data.frame(
  pred_rf_test,
  pred_xgb_test,
  check.names = FALSE
)

# Vérification importante
stopifnot(
  identical(
    names(meta_data)[
      names(meta_data) != "Y"
    ],
    names(meta_test)
  )
)

stacked_probs <- predict(
  meta_model,
  meta_test,
  type = "probs"
)

if (is.null(dim(stacked_probs))) {

  stacked_probs <- matrix(
    stacked_probs,
    ncol = K
  )
}

colnames(stacked_probs) <- classes

```

# Premiers résultats

## Classes prédites

```{r}

rf_pred <- factor(
  classes[
    max.col(pred_rf_test)
  ],
  levels = classes
)

xgb_pred <- factor(
  classes[
    max.col(pred_xgb_test)
  ],
  levels = classes
)

stack_pred <- factor(
  classes[
    max.col(stacked_probs)
  ],
  levels = classes
)

```

## Matrices de confusion

```{r}

cm_rf <- confusionMatrix(
  rf_pred,
  test_data$Y,
  mode = "everything"
)

cm_xgb <- confusionMatrix(
  xgb_pred,
  test_data$Y,
  mode = "everything"
)

cm_stack <- confusionMatrix(
  stack_pred,
  test_data$Y,
  mode = "everything"
)

```

## Comparaison des accuracies

```{r}

accuracy_results <- data.frame(
  Modele = c(
    "Random Forest",
    "XGBoost",
    "Stacking"
  ),
  Accuracy = c(
    cm_rf$overall["Accuracy"],
    cm_xgb$overall["Accuracy"],
    cm_stack$overall["Accuracy"]
  )
)

print(accuracy_results)

```

## Matrices de confusion pondérées

```{r}

weighted_confusion <- function(
  pred,
  truth,
  weights
) {

  xtabs(
    weights ~ pred + truth,
    data = data.frame(
      pred = factor(
        pred,
        levels = classes
      ),
      truth = factor(
        truth,
        levels = classes
      ),
      weights = weights
    )
  )
}

weighted_cm_rf <- weighted_confusion(
  rf_pred,
  test_data$Y,
  w_test
)

weighted_cm_xgb <- weighted_confusion(
  xgb_pred,
  test_data$Y,
  w_test
)

weighted_cm_stack <- weighted_confusion(
  stack_pred,
  test_data$Y,
  w_test
)

```

## Importance des variables

```{r}

# Importance RF
rf_importance <- sort(
  final_rf$variable.importance,
  decreasing = TRUE
)

# Importance XGBoost
xgb_importance <- xgb.importance(
  model = final_xgb
)

```

## Résultats finaux à comparer

```{r}

cat("\n--- RF ---\n")
print(cm_rf)

cat("\n--- XGBoost ---\n")
print(cm_xgb)

cat("\n--- Stacking ---\n")
print(cm_stack)

cat("\n--- Accuracy ---\n")
print(accuracy_results)

cat("\n--- Importance RF ---\n")
print(rf_importance)

cat("\n--- Importance XGBoost ---\n")
print(xgb_importance)

cat("\n--- Matrice pondérée RF ---\n")
print(weighted_cm_rf)

cat("\n--- Matrice pondérée XGBoost ---\n")
print(weighted_cm_xgb)

cat("\n--- Matrice pondérée Stacking ---\n")
print(weighted_cm_stack)

```

